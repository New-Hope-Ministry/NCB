{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Launch Node afixMin.js",
            "program": "${workspaceFolder}/data/afixMin.js",
            "request": "launch",
            "skipFiles": ["<node_internals>/**"],
            "type": "node"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch chron.html",
            "url": "http://localhost:5500/apps/chron.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch comp.html",
            "url": "http://localhost:5500/apps/comp.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch index.html",
            "url": "http://localhost:5500/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch srch.html",
            "url": "http://localhost:5500/apps/srch.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch synth.html",
            "url": "http://localhost:5500/apps/synth.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch ZZ-apps.html",
